{
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/api/promo-banner",
      "destination": "/api/home-sections?type=promo-banner"
    },
    {
      "source": "/api/site-counters",
      "destination": "/api/home-sections?type=site-counters"
    },
    {
      "source": "/api/note-collections",
      "destination": "/api/home-sections?type=note-collections"
    },
    {
      "source": "/api/trending-houses",
      "destination": "/api/home-sections?type=trending-houses"
    },
    {
      "source": "/api/fragrance-sets",
      "destination": "/api/home-sections?type=fragrance-sets"
    },
    {
      "source": "/api/hero-sedes",
      "destination": "/api/home-sections?type=hero-sedes"
    },
    {
      "source": "/api/shipping-zones",
      "destination": "/api/home-sections?type=shipping-zones"
    },
    {
      "source": "/api/shipping-settings",
      "destination": "/api/home-sections?type=shipping-zones"
    },
    {
      "source": "/api/contact-channels",
      "destination": "/api/home-sections?type=contact-channels"
    },
    {
      "source": "/api/channels",
      "destination": "/api/home-sections?type=contact-channels"
    },
    {
      "source": "/api/admin/reels",
      "destination": "/api/reels?admin=true"
    },
    {
      "source": "/api/admin/reviews",
      "destination": "/api/reviews?admin=true"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|avif|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
